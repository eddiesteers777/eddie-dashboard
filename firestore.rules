rules_version = '2';

// EddieOS Firestore Security Rules
//
// This file is not auto-deployed by this repo -- there's no CI/CD
// wired up for Firestore. Paste this into Firebase Console ->
// Firestore Database -> Rules (or `firebase deploy --only
// firestore:rules` if you have the CLI set up) whenever it changes.
//
// Collections:
//   users/{uid}/sync/{docId}   Each user's full private data blob
//                              (nutrition, strength, everything).
//                              Only that user can ever read/write it.
//   inviteCodes/{code}         Short-lived, single-use codes a client
//                              generates to hand their coach. Deleted
//                              immediately after redemption.
//   coachLinks/{coachUid}_{clientUid}
//                              Proof a client consented to give a
//                              specific coach access. Created only by
//                              redeeming that client's invite code.
//   sharedPlans/{clientUid}    A mirror of just that client's
//                              Training Plans + Race Plans (never
//                              their nutrition/strength/other data),
//                              plus coach notes. The client's device
//                              keeps this current automatically; a
//                              linked coach reads and edits it here.
//   coachAvailability/{coachUid}
//                              A coach's recurring weekly open time
//                              slots (day/time/session type/capacity)
//                              plus blackout dates. Visible only to
//                              the coach and clients already linked
//                              to them via coachLinks.
//   bookingRequests/{id}       A client's request to book a slot
//                              (single date or a recurring series).
//                              Only the coach who owns the slot and
//                              the requesting client can see or act
//                              on it. Creating one requires an
//                              existing coachLinks relationship, so
//                              booking is invite-only like plan
//                              sharing is.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/sync/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      // Any signed-in user can read a code (needed to redeem it) or
      // delete one (needed to burn it on redemption -- the coach
      // doing the redeeming is never the client who created the
      // code, so a narrower rule here would leave codes reusable
      // forever instead of single-use). Only the client who
      // generated a code can create it in the first place.
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.clientUid;
    }

    match /coachLinks/{linkId} {
      // Only the two people in the link can ever see or remove it.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);
      // Only the coach redeeming a code can create the link, and only
      // as themselves -- they can't forge a link naming another coach.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.coachUid
        && linkId == request.auth.uid + '_' + request.resource.data.clientUid;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);
    }

    match /sharedPlans/{clientUid} {
      // The client always has full access to their own mirror.
      allow read, write: if request.auth != null && request.auth.uid == clientUid;
      // A coach gets access only once a matching coachLinks doc
      // proves the client linked them -- never by default.
      allow read, write: if request.auth != null && exists(
        /databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + clientUid)
      );
    }

    match /coachAvailability/{coachUid} {
      allow write: if request.auth != null && request.auth.uid == coachUid;
      // A linked client needs to browse this to book anything.
      allow read: if request.auth != null && (
        request.auth.uid == coachUid ||
        exists(/databases/$(database)/documents/coachLinks/$(coachUid + '_' + request.auth.uid))
      );
    }

    match /bookingRequests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);
      // A client can only request time from a coach they're already
      // linked to (same invite-code trust as plan sharing), and only
      // ever as themselves.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.clientUid
        && exists(/databases/$(database)/documents/coachLinks/$(request.resource.data.coachUid + '_' + request.auth.uid));
      // Coach approves/denies, or either side cancels.
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);
    }
  }
}
