{
  "permissions": {
    "allow": [
      "Bash(git checkout main)",
      "Bash(git checkout claude/*)",
      "Bash(git merge *)",
      "Bash(git push origin main)"
    ]
  },
  "extraKnownMarketplaces": {
    "southbound-tools": {
      "source": {
        "source": "github",
        "repo": "eddiesteers777/eddie-dashboard"
      }
    }
  },
  "enabledPlugins": {
    "auto-model@southbound-tools": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
