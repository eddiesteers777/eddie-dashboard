rules_version = '2';

// Southbound Coaching Firestore Security Rules
//
// This file is not auto-deployed by this repo. Paste the WHOLE file into
// Firebase Console -> Firestore Database -> Rules -> Publish whenever it
// changes. `npm run test:rules` exercises it against the local emulator
// (tests/rules.test.mjs), and CI runs the same tests on every push.
//
// Collections:
//   users/{uid}/sync/{docId}   Each user's private data blob. Owner only.
//   userProfiles/{uid}         Role / status / services. Readable only by
//                              the owner and approved coaches (who need
//                              the Pending list). A user can only edit
//                              their own application fields; everything
//                              that grants access is coach-only.
//   inviteCodes/{code}         One-time codes a client hands a coach.
//                              Never listable; expire after 7 days.
//   coachLinks/{coach}_{client} Proof a client invited a coach. Can only
//                              be created by an approved coach, in the
//                              same atomic batch that deletes (burns) a
//                              valid invite code from that client -- so a
//                              link can't be forged and a code can't be
//                              redeemed twice.
//   sharedPlans/{clientUid}    Client's plan mirror; a linked coach can
//                              read and edit it.
//   coachAvailability/{coach}  Weekly slots; visible to linked clients.
//   bookingRequests/{id}       Client requests; only the coach can approve
//                              or deny, the client can only cancel, and
//                              the booking details themselves never change.
//   checkins/{client}_{week}   Weekly check-ins; the client writes the
//                              rating/notes, the coach writes feedback.
//   inquiries/{id}             Questions from the public Contact page.
//                              Anyone can send one (strictly validated);
//                              only approved coaches can read them.
//
// The very first coach is bootstrapped by hand in the Firebase Console
// (isCoachApproved: true on their own userProfiles doc), since no
// approved coach exists yet to approve them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/userProfiles/$(uid);
    }

    function isApprovedCoach() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.isCoachApproved == true;
    }

    function linked(coachUid, clientUid) {
      return exists(/databases/$(database)/documents/coachLinks/$(coachUid + '_' + clientUid));
    }

    // True when an update touches only the listed fields.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid}/sync/{docId} {
      allow read, write: if isUser(uid);
    }

    match /userProfiles/{uid} {
      allow get: if isUser(uid) || isApprovedCoach();
      allow list: if isApprovedCoach();

      // Self-signup always starts as an unapproved, pending client with
      // no services -- it can never grant itself anything.
      allow create: if isUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == "client"
        && request.resource.data.isCoachApproved == false
        && request.resource.data.status == "pending"
        && request.resource.data.services.size() == 0;

      // A user may only fill in their own application; role, status,
      // services and isCoachApproved are set by an approved coach.
      allow update: if (isUser(uid) && onlyChanges([
          "requestedServices", "applicationMessage", "applicationSubmittedAt",
          "displayName", "email"
        ]))
        || isApprovedCoach();
    }

    match /inviteCodes/{code} {
      allow create: if signedIn()
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(["clientUid", "clientName", "clientEmail", "createdAt"]);

      // Look up one code by its exact value -- never list them.
      allow get: if isApprovedCoach()
        || (resource != null && resource.data.clientUid == request.auth.uid);
      allow list: if false;

      // Its client can withdraw it; an approved coach can only burn it
      // as part of the batch that creates the matching link.
      allow delete: if signedIn() && (
        resource.data.clientUid == request.auth.uid
        || (isApprovedCoach() && existsAfter(
             /databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + resource.data.clientUid)))
      );
    }

    match /coachLinks/{linkId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);

      allow create: if isApprovedCoach()
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.clientUid != request.auth.uid
        && linkId == request.auth.uid + '_' + request.resource.data.clientUid
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.clientUid
             == request.resource.data.clientUid
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.createdAt
             > request.time - duration.value(7, 'd')
        && !existsAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode));

      allow update: if false;

      allow delete: if signedIn()
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);
    }

    match /sharedPlans/{clientUid} {
      allow read, write: if isUser(clientUid)
        || (signedIn() && linked(request.auth.uid, clientUid));
    }

    match /coachAvailability/{coachUid} {
      allow write: if isUser(coachUid);
      allow read: if isUser(coachUid)
        || (signedIn() && linked(coachUid, request.auth.uid));
    }

    match /bookingRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);

      allow create: if signedIn()
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.status == "requested"
        && request.resource.data.coachNote == ""
        && linked(request.resource.data.coachUid, request.auth.uid);

      allow update: if signedIn() && (
        // The coach approves, denies or cancels, with an optional note.
        (request.auth.uid == resource.data.coachUid
          && request.resource.data.status in ["approved", "denied", "cancelled"]
          && onlyChanges(["status", "coachNote", "respondedAt"]))
        ||
        // The client can only cancel their own request.
        (request.auth.uid == resource.data.clientUid
          && request.resource.data.status == "cancelled"
          && onlyChanges(["status", "respondedAt"]))
      );

      allow delete: if false;
    }

    // Questions from the public Contact page. Anyone may send one
    // (no sign-in), so every field is checked; only approved coaches
    // can read them, and the coach can only mark them handled.
    function validInquiry(d) {
      return d.keys().hasOnly(["name", "email", "phone", "interest", "who",
                               "athleteAge", "message", "status", "createdAt"])
        && d.keys().hasAll(["name", "email", "phone", "interest", "who",
                            "athleteAge", "message", "status", "createdAt"])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() <= 200
        && (d.email.size() == 0 || d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
        && d.phone is string && d.phone.size() <= 40
        && (d.email.size() > 0 || d.phone.size() > 0)
        && d.interest in ["online_coaching", "running_strength", "soccer_1on1", "soccer_group", "other"]
        && d.who in ["self", "child"]
        && d.athleteAge is string && d.athleteAge.size() <= 20
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && d.status == "new"
        && d.createdAt == request.time;
    }

    match /inquiries/{inquiryId} {
      allow create: if validInquiry(request.resource.data);
      allow read: if isApprovedCoach();
      allow update: if isApprovedCoach()
        && request.resource.data.status in ["new", "handled"]
        && onlyChanges(["status", "handledAt"]);
      allow delete: if isApprovedCoach();
    }

    match /checkins/{checkinId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.clientUid
            || request.auth.uid == resource.data.coachUid);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.clientUid
        && checkinId == request.auth.uid + '_' + request.resource.data.weekOf
        && request.resource.data.status == "submitted"
        && request.resource.data.coachFeedback == ""
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && linked(request.resource.data.coachUid, request.auth.uid);

      allow update: if signedIn() && (
        // The client resubmits their rating/notes, which puts it back in
        // the coach's queue.
        (request.auth.uid == resource.data.clientUid
          && request.resource.data.status == "submitted"
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && onlyChanges(["rating", "notes", "status", "reviewedAt", "submittedAt",
                          "clientName", "clientEmail", "coachName"]))
        ||
        // The coach writes feedback and marks it reviewed.
        (request.auth.uid == resource.data.coachUid
          && request.resource.data.status == "reviewed"
          && onlyChanges(["coachFeedback", "status", "reviewedAt"]))
      );
    }
  }
}
